# Public site origin, no trailing slash. Example: https://maison-eko.vercel.app
NEXT_PUBLIC_SITE_URL=

# Pooled connection for the application (hostname includes -pooler)
DATABASE_URL=DATABASE_URL_REDACTED

# Direct connection for Drizzle Kit migrations (hostname does NOT include -pooler)
DATABASE_URL_UNPOOLED=DATABASE_URL_UNPOOLED_REDACTED

# Clerk. Used only by the owner dashboard, never by the customer site.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The single Clerk user ID allowed into /admin.
ADMIN_USER_ID=

# WhatsApp handoff number in international format, digits only, no plus.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Demo-only bank details shown on the confirmation page.
DEMO_BANK_NAME=
DEMO_ACCOUNT_NAME=
DEMO_ACCOUNT_NUMBER=