# Public site origin, no trailing slash. Example: https://maison-eko.vercel.app
NEXT_PUBLIC_SITE_URL=

# Neon Postgres connection string. The app connects with the WebSocket Pool.
DATABASE_URL=

# Clerk. Used only by the owner dashboard, never by the customer site.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The single Clerk user ID allowed into /admin. Any other signed-in user is rejected server-side.
ADMIN_USER_ID=

# WhatsApp handoff number in international format, digits only, no plus. If empty, the button is not rendered.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Demo-only bank details shown on the confirmation page. Never real account details.
DEMO_BANK_NAME=
DEMO_ACCOUNT_NAME=
DEMO_ACCOUNT_NUMBER=